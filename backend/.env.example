# Gnani speech (Prisma STT + Timbre TTS). Get a key at https://app.gnani.ai/voice
GNANI_API_KEY=

# Dialogue LLM: any OpenAI-compatible endpoint with tool calling. Groq is the default.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
CARELOOP_LLM_REVIEW=1

# Optional
DATABASE_URL=sqlite:///./careloop.db
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CARELOOP_STT_MODEL=prisma-v2.5
CARELOOP_TTS_MODEL=timbre-v2.5
CARELOOP_SCHEDULER=1
CARELOOP_SCHEDULER_TICK_SECONDS=20
CARELOOP_RING_TIMEOUT_SECONDS=90
CARELOOP_RETRY_INTERVAL_MINUTES=120
CARELOOP_MAX_ATTEMPTS=3
CARELOOP_MAX_CALL_SECONDS=360
CARELOOP_ADHERENCE_MISS_THRESHOLD=2
CARELOOP_STORE_AUDIO=0
